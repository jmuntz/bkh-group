# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# Canonical site URL for metadata and social previews
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Optional: Publishable key for client-side `@supabase/supabase-js` only (never use Secret in the browser)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server `/api/send`: elevated key - Secret (sb_secret_…) or Legacy service_role JWT
SUPABASE_SECRET=
# Legacy alias (still read if SUPABASE_SECRET is unset):
# SUPABASE_SERVICE_ROLE_KEY=

# Resend - `/api/send` accepts either naming style:
RESEND_API_KEY=
LEAD_FORM_FROM_EMAIL=
# Primary recipient for new lead notification emails (Resend "to"):
LEAD_FORM_NOTIFICATION_EMAIL=
# Aliases (same purpose - used if LEAD_FORM_* unset):
# RESEND_FROM_EMAIL=
# RESEND_TO_EMAIL=
# BCC on every normal enquiry (skipped if same address as the primary "to" above):
# RESEND_ADMIN_EMAIL=

# If the lead form email field matches this (case-insensitive), the API saves to
# Supabase only and does not send a notification email (for safe testing).
RESEND_TEST_EMAIL=
